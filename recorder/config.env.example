# ─────────────────────────────────────────────────────────
# CamWatch — Recorder PC Configuration
# ─────────────────────────────────────────────────────────

# JSON array of cameras to record.
# For MediaMTX streams via Tailscale (VPS):
#   CAMERAS='[{"name":"entrada","url":"rtsp://100.x.x.x:8554/cam-1"},{"name":"cochera","url":"rtsp://100.x.x.x:8554/cam-2"}]'
#
# For direct LAN cameras (faster, no VPS dependency):
#   CAMERAS='[{"name":"entrada","url":"rtsp://192.168.1.101:554/stream1"},{"name":"cochera","url":"rtsp://192.168.1.102:554/h264"}]'
CAMERAS='[{"name":"cam-1","url":"rtsp://camara-1:554/stream1"}]'

# Segment duration in seconds (default: 600 = 10 minutes)
SEGMENT_TIME=600

# Seconds to wait before restarting FFmpeg after a crash
RETRY_DELAY=10

# Timezone for recording timestamps in file names
TZ=America/Mexico_City
