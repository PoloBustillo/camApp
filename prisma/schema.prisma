// CamWatch Platform — Prisma Schema
// Basado en el diseño de BD aprobado (docs/fase-3-diseno-tecnico/03-diseno-base-datos.md)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum UserRole {
  admin
  operator
  viewer
}

enum UserStatus {
  active
  inactive
  locked
}

enum GridType {
  single
  quad
  hexa
  nine
}

enum EdgeStatus {
  online
  offline
  unknown
}

enum ServerType {
  mediaMtx
  go2rtc
}

enum CameraProtocol {
  rtsp
  rtmp
  webrtc
  hls
}

enum StreamEventType {
  online
  offline
  error
  reconnecting
}

enum AuditAction {
  user_login
  user_logout
  user_created
  user_updated
  user_deleted
  camera_created
  camera_updated
  camera_deleted
  camera_viewed
  layout_created
  layout_updated
  layout_deleted
  layout_duplicated
  location_created
  location_updated
  location_deleted
  site_created
  site_updated
  site_deleted
  stream_access
  auth_failure
  system_event
  recording_deleted
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model User {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String     @db.VarChar(255)
  email          String     @unique @db.VarChar(255)
  passwordHash   String     @map("password_hash") @db.VarChar(255)
  role           UserRole   @default(viewer)
  status         UserStatus @default(active)
  failedAttempts Int        @default(0) @map("failed_attempts") @db.SmallInt
  lockedUntil    DateTime?  @map("locked_until") @db.Timestamptz()
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz()
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt      DateTime?  @map("deleted_at") @db.Timestamptz()

  refreshTokens   RefreshToken[]
  layouts         Layout[]
  auditLogs       AuditLog[]
  favorites       UserFavorite[]
  cameraOrders    UserCameraOrder[]
  cameraFilters   UserCameraFilter[]

  @@index([role], name: "idx_users_role")
  @@map("users")
}

model EdgeServer {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String     @db.VarChar(255)
  tailscaleIp     String     @unique @map("tailscale_ip") @db.VarChar(50)
  serverType      ServerType @default(mediaMtx) @map("server_type")
  mediamtxApiPort Int        @default(9997) @map("mediamtx_api_port") @db.SmallInt
  webrtcPort      Int        @default(8889) @map("webrtc_port") @db.SmallInt
  go2rtcApiPort   Int        @default(1984) @map("go2rtc_api_port") @db.SmallInt
  go2rtcWebRtcPort Int       @default(8555) @map("go2rtc_webrtc_port") @db.SmallInt
  publicHost      String     @map("public_host") @db.VarChar(255)
  status          EdgeStatus @default(unknown)
  lastSeenAt      DateTime?  @map("last_seen_at") @db.Timestamptz()
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz()

  locations Location[]
  cameras   Camera[]

  @@map("edge_servers")
}

model Location {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  edgeServerId String    @map("edge_server_id") @db.Uuid
  name         String    @db.VarChar(255)
  description  String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz()

  edgeServer EdgeServer @relation(fields: [edgeServerId], references: [id])

  @@index([edgeServerId], name: "idx_locations_edge_server")
  @@map("locations")
}

model MediaMtxServer {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  baseUrl     String   @map("base_url") @db.VarChar(500)
  apiUrl      String   @map("api_url") @db.VarChar(500)
  description String?  @db.Text
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  cameras Camera[]

  @@map("mediamtx_servers")
}

model Camera {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  siteId           String?        @map("site_id") @db.Uuid
  mediaMtxServerId String?        @map("mediamtx_server_id") @db.Uuid
  mediaMtxPath     String?        @map("mediamtx_path") @db.VarChar(500)
  edgeServerId     String?        @map("edge_server_id") @db.Uuid
  substreamPath    String?        @map("substream_path") @db.VarChar(500)
  name             String         @db.VarChar(255)
  description      String?        @db.Text
  // pathEncrypted: AES-256-GCM. Formato base64(iv):base64(ciphertext):base64(authTag)
  // Almacena la URL completa (ej: rtsp://user:pass@host:554/stream) cifrada
  pathEncrypted    String         @map("path_encrypted") @db.Text
  protocol         CameraProtocol @default(rtsp)
  enabled          Boolean        @default(true)
  online           Boolean        @default(false)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  site           Site?           @relation(fields: [siteId], references: [id])
  mediaMtxServer MediaMtxServer? @relation(fields: [mediaMtxServerId], references: [id], onDelete: SetNull)
  edgeServer     EdgeServer?     @relation(fields: [edgeServerId], references: [id], onDelete: SetNull)
  layoutCells    LayoutCell[]
  streamEvents   StreamEvent[]
  favoritedBy    UserFavorite[]
  recordings     Recording[]
  userOrders     UserCameraOrder[]
  userFilters    UserCameraFilter[]

  @@index([siteId], name: "idx_cameras_site")
  @@index([enabled], name: "idx_cameras_enabled")
  @@index([mediaMtxServerId], name: "idx_cameras_mediamtx_server")
  @@index([edgeServerId], name: "idx_cameras_edge_server")
  @@map("cameras")
}

model Recording {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cameraId       String    @map("camera_id") @db.Uuid
  date           DateTime  @db.Date
  fileName       String    @map("file_name") @db.VarChar(255)
  startTime      DateTime  @map("start_time") @db.Timestamptz()
  endTime        DateTime? @map("end_time") @db.Timestamptz()
  duration       Int?      // seconds
  fileSize       Int?      @map("file_size") // bytes
  thumbnail      String?   @db.VarChar(500)
  // Forensic metadata (client-side recordings)
  fileHash       String?   @map("file_hash") @db.VarChar(128) // SHA-256
  codec          String?   @db.VarChar(50)
  resolution     String?   @db.VarChar(20) // e.g. "1920x1080"
  fps            Int?      @db.SmallInt
  sourceType     String    @default("server") @map("source_type") @db.VarChar(32) // server | client
  capturedBy     String?   @map("captured_by") @db.VarChar(255) // user email
  captureDevice  String?   @map("capture_device") @db.VarChar(255) // browser/OS
  serverTimestamp DateTime? @map("server_timestamp") @db.Timestamptz() // trusted timestamp
  custodyLog     Json?     @map("custody_log") @db.JsonB // chain of custody entries
  // Cloud backup (Cloudflare R2)
  cloudStorageKey    String?   @map("cloud_storage_key") @db.VarChar(500) // S3 object key
  cloudBackupAt      DateTime? @map("cloud_backup_at") @db.Timestamptz() // when uploaded to R2
  cloudBackupStatus  String    @default("none") @map("cloud_backup_status") @db.VarChar(20) // none | pending | uploaded | failed

  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()
  legalHold     Boolean   @default(false) @map("legal_hold")

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: NoAction)

  @@unique([cameraId, date, fileName])
  @@index([cameraId, date(sort: Desc)], name: "idx_recordings_camera_date")
  @@index([sourceType], name: "idx_recordings_source_type")
  @@index([cloudBackupStatus], name: "idx_recordings_cloud_backup_status")
  @@index([cloudBackupStatus, startTime(sort: Desc)], name: "idx_recordings_backup_time")
  @@index([date(sort: Desc), startTime(sort: Desc)], name: "idx_recordings_date_time")
  @@map("recordings")
}

model Layout {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId       String    @map("owner_id") @db.Uuid
  name          String    @db.VarChar(255)
  gridType      GridType  @default(quad) @map("grid_type")
  isDefault     Boolean   @default(false) @map("is_default")
  isShared      Boolean   @default(false) @map("is_shared")
  // configuration: full dashboard state snapshot
  // { gridLayout, cellCameraIds, customCols, customRows }
  configuration Json?     @db.JsonB
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz()

  owner User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cells LayoutCell[]

  @@index([ownerId], name: "idx_layouts_owner")
  @@index([isShared], name: "idx_layouts_shared")
  @@map("layouts")
}

model LayoutCell {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  layoutId String  @map("layout_id") @db.Uuid
  cameraId String? @map("camera_id") @db.Uuid
  position Int     @db.SmallInt
  label    String? @db.VarChar(100)

  layout Layout  @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  camera Camera? @relation(fields: [cameraId], references: [id], onDelete: SetNull)

  @@unique([layoutId, position], name: "layout_cells_position_unique")
  @@index([layoutId], name: "idx_layout_cells_layout")
  @@index([cameraId], name: "idx_layout_cells_camera")
  @@map("layout_cells")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // jti: JWT ID claim, usado para revocar tokens específicos
  jti       String    @unique @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz()
  userAgent String?   @map("user_agent") @db.Text
  ipAddress String?   @map("ip_address") @db.VarChar(50)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], name: "idx_refresh_tokens_user")
  @@index([jti], name: "idx_refresh_tokens_jti")
  @@index([expiresAt], name: "idx_refresh_tokens_expires")
  @@map("refresh_tokens")
}

model StreamEvent {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cameraId  String          @map("camera_id") @db.Uuid
  eventType StreamEventType @map("event_type")
  message   String?         @db.Text
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@index([cameraId, createdAt(sort: Desc)], name: "idx_stream_events_camera")
  @@map("stream_events")
}

model AuditLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?     @map("user_id") @db.Uuid
  action       AuditAction
  resourceType String?     @map("resource_type") @db.VarChar(50)
  resourceId   String?     @map("resource_id") @db.Uuid
  metadata     Json?       @db.JsonB
  ipAddress    String?     @map("ip_address") @db.VarChar(50)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], name: "idx_audit_logs_user")
  @@index([action, createdAt], name: "idx_audit_logs_action")
  @@index([resourceType, resourceId], name: "idx_audit_logs_resource")
  @@map("audit_logs")
}

model Site {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text
  timezone    String    @default("UTC") @db.VarChar(100)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()

  cameras Camera[]

  @@index([active], name: "idx_sites_active")
  @@map("sites")
}

model UserFavorite {
  userId    String   @map("user_id") @db.Uuid
  cameraId  String   @map("camera_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([userId, cameraId])
  @@index([userId], name: "idx_user_favorites_user")
  @@map("user_favorites")
}

model UserCameraOrder {
  userId   String @map("user_id") @db.Uuid
  cameraId String @map("camera_id") @db.Uuid
  position Int    @db.SmallInt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([userId, cameraId])
  @@index([userId], name: "idx_user_camera_order_user")
  @@map("user_camera_order")
}

model UserCameraFilter {
  userId     String @map("user_id") @db.Uuid
  cameraId   String @map("camera_id") @db.Uuid
  brightness Int    @default(100) @db.SmallInt
  contrast   Int    @default(100) @db.SmallInt
  saturation Int    @default(100) @db.SmallInt
  preset     String @default("normal") @db.VarChar(32)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  camera Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([userId, cameraId])
  @@index([userId], name: "idx_user_camera_filter_user")
  @@map("user_camera_filter")
}
