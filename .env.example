# ─────────────────────────────────────────────────────────────
# CamWatch Platform — Variables de Entorno
# Copia este archivo como .env.local y completa los valores
# NUNCA cometas .env.local al repositorio
# ─────────────────────────────────────────────────────────────

# ─── Base de Datos ───────────────────────────────────────────
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Desarrollo local (fuera de Docker): usar localhost
# Dentro de Docker (producción): cambiar localhost → postgres
DATABASE_URL="postgresql://camwatch:camwatch_dev_password@postgres:5432/camwatch"

# Credenciales del contenedor PostgreSQL (para docker-compose)
POSTGRES_USER=camwatch
POSTGRES_PASSWORD=camwatch_dev_password
POSTGRES_DB=camwatch

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── JWT / Autenticación ─────────────────────────────────────
# Genera secrets seguros con: openssl rand -hex 32
# JWT_ACCESS_SECRET="REPLACE_WITH_SECURE_RANDOM_64_CHAR_HEX"
# JWT_REFRESH_SECRET="REPLACE_WITH_ANOTHER_SECURE_RANDOM_64_CHAR_HEX"

# Secret para tokens temporales de stream (MediaMTX valida este secret)
MEDIAMTX_JWT_SECRET="REPLACE_WITH_MEDIAMTX_JWT_SECRET"

# URL base del servidor MediaMTX para streams WebRTC (WHEP)
# Formato: http://<host>:<webrtc-port>  (default MediaMTX webrtc port: 8889)
# Ejemplo con Tailscale: http://100.64.0.1:8889
# Ejemplo con host público: http://edge.tudominio.com:8889
MEDIAMTX_WEBRTC_URL="http://100.64.0.1:8889"

# Basic Auth para la API y streams WebRTC de MediaMTX (usado server-side en el proxy WHEP)
MEDIAMTX_USER="camwatch"
MEDIAMTX_PASSWORD="REPLACE_WITH_MEDIAMTX_PASSWORD"

# Timeout en ms para peticiones a la API de MediaMTX (default: 5000)
MEDIAMTX_API_TIMEOUT_MS=5000

# ─── Cifrado de Credenciales RTSP ────────────────────────────
# Clave AES-256: exactamente 64 caracteres hex (32 bytes)
# Genera con: openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_WITH_64_CHAR_HEX_KEY"

# ─── Seed ────────────────────────────────────────────────────
# Credenciales del usuario admin creado por el seed inicial
SEED_ADMIN_EMAIL="admin@camwatch.local"
SEED_ADMIN_PASSWORD="Admin123!"

# ─── Next.js ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ─── Auth.js v5 ──────────────────────────────────────────────
# Genera el secret con: openssl rand -base64 32
AUTH_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"

# URL completa de la aplicación (requerida para callbacks OAuth)
AUTH_URL="http://localhost:3000"

# ─── Cloud Backup (Backblaze B2) ──────────────────────────────
# Backblaze B2: 10GB gratis, sin tarjeta de crédito
# Crear bucket en: https://secure.backblaze.com/b2_buckets.htm
# Access keys en: Application Keys → Add a New Application Key
# Endpoint: https://s3.us-west-000.blazeb2.com (o tu región)
CLOUD_ACCESS_KEY_ID=""
CLOUD_SECRET_ACCESS_KEY=""
CLOUD_BUCKET_NAME="camwatch-recordings"
CLOUD_ENDPOINT="https://s3.us-east-005.backblazeb2.com"

# ─── Recorder PC ─────────────────────────────────────────────
# URL del servidor Nginx en el PC grabador (para sync y backup)
# RECORDER_PC_URL="http://192.168.1.100:8080"
